# OneAPI 开发环境配置

# 数据库配置
SQL_DSN="oneapi:123456@tcp(localhost:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local"
REDIS_CONN_STRING=redis://localhost:6379

# 会话配置
SESSION_SECRET=dev_session_secret_2025

# 时区
TZ=Asia/Shanghai

# 同步频率
SYNC_FREQUENCY=60

# 课件平台集成配置
COURSEWARE_ENABLED=true
COURSEWARE_PLATFORM_BASE_URL=http://192.168.6.210:8080
COURSEWARE_PLATFORM_API_KEY=mock_api_key_123
COURSEWARE_PLATFORM_TIMEOUT=5
COURSEWARE_CACHE_TTL=10m
COURSEWARE_REFRESH_INTERVAL=1h
COURSEWARE_PRELOAD_BATCH_SIZE=100
COURSEWARE_DEFAULT_GROUP=default

# Webhook 密钥（启用后才会校验签名）
COURSEWARE_WEBHOOK_SECRET=dev_webhook_secret

# 调试配置
DEBUG=true
DEBUG_SQL=true
MEMORY_CACHE_ENABLED=true

# 主题
THEME=default 