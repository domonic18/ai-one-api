# 测试环境配置文件
# 用于集成测试连接数据库和Redis服务

# 数据库配置
SQL_DSN=testuser:testpass@tcp(localhost:3306)/oneapi_test?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=testuser
MYSQL_PASSWORD=testpass
MYSQL_DATABASE=oneapi_test

# Redis配置
REDIS_CONN_STRING=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# 应用配置
DEBUG=true
GLOBAL_WEB_RATE_LIMIT=0
GLOBAL_API_RATE_LIMIT=0
SESSION_SECRET=test-secret-key
SYNC_FREQUENCY=60

# 课件平台API配置（测试用）
COURSEWARE_PLATFORM_BASE_URL=http://localhost:8080
COURSEWARE_PLATFORM_API_KEY=test-api-key

# 测试超时配置
TEST_TIMEOUT=10m 